APP_NAME=Nest Web App
# local = tabel dibuat/disinkronkan otomatis (TypeORM synchronize) + view tanpa cache
APP_ENV=local
APP_DEBUG=true

# Kunci penanda session (login). GANTI dengan string acak panjang.
APP_KEY=change-me-to-a-long-random-string

# Port di DALAM container (harus cocok dengan sisi kanan mapping port)
APP_PORT=8000

# Mode Node: development | production | test
NODE_ENV=development

# Nama package npm (dipakai saat scaffold pertama kali)
NEST_PROJECT_NAME=nest-api

# ----------------------------------------------------------
# Port di KOMPUTER host (bedakan per project)
# ----------------------------------------------------------
HOST_APP_PORT=8200
HOST_DB_PORT=3109
HOST_PMA_PORT=9192

# ----------------------------------------------------------
# Database
# DB_HOST = nama service/container MySQL di Docker, BUKAN 127.0.0.1
# ----------------------------------------------------------
DB_HOST=kazuya-mysql
DB_PORT=3306
DB_DATABASE=db_nest
DB_USERNAME=kazuya
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

# ----------------------------------------------------------
# Seeder (php artisan db:seed)
# true = isi user admin + data dummy units saat start.
# Setelah terisi, ubah ke false.
# ----------------------------------------------------------
SEED=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password
